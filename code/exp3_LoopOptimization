#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
    size_t n = 200000;
    char *s = malloc(n + 1);
    for (size_t i = 0; i < n; i++) {
        s[i] = (i % 3 == 0) ? 'a' : 'b';
    }
    s[n] = '\0';

    int count = 0;
    for (size_t i = 0; i < strlen(s); i++) {
        if (s[i] == 'a') {
            count++;
        }
    }

    printf("%d\n", count);   // printed, so DCE can't delete the loop
    free(s);
    return 0;
}
